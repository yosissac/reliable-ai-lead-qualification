# Copy to .env and replace every REPLACE_ME value before starting services.
# Never commit the resulting .env file.

# Docker image versions tested by this project.
N8N_VERSION=2.40.7
POSTGRES_VERSION=17-alpine

# Local-only n8n listener. Docker Compose binds this to 127.0.0.1.
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Africa/Nairobi

# n8n's internal database and credential-encryption settings.
POSTGRES_DB=n8n
POSTGRES_USER=n8n_owner
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Least-privilege account used by the lead workflow through an n8n
# PostgreSQL credential named "Postgres - Lead Automation".
LEAD_DB_USER=lead_app
LEAD_DB_PASSWORD=REPLACE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Non-secret workflow configuration. These values are entered in the
# "Workflow Configuration" node after importing the workflow.
OPENAI_MODEL=gpt-5.6-luna
SLACK_CHANNEL_ID=REPLACE_ME_WITH_SLACK_CHANNEL_ID
GOOGLE_SPREADSHEET_ID=REPLACE_ME_WITH_GOOGLE_SPREADSHEET_ID
GOOGLE_SHEET_NAME=Leads

# Secrets below belong in n8n Credentials, never in this file for production:
# - Website webhook header credential (X-Webhook-Key)
# - Website HMAC secret in an n8n Crypto credential
# - OpenAI API bearer credential
# - Google Sheets OAuth2/service-account credential
# - Slack bot bearer credential
